# 1. Google Gemini API Key (Required for LLM Function Calling)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# 2. ElevenLabs API Key (Required for STT and TTS)
# Get your API key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID (Default: Rachel - professional clinical tone)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Server Configuration
HOST=0.0.0.0
PORT=8000
